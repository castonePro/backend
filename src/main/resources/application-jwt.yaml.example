#로그인 토큰 설정
#로그인 성공 시 발급하는 JWT 토큰 암호화 키랑 유효기간
#이게 없으면 로그인 기능 자체가 안 됨
#
# 이 파일을 복사해서 application-jwt.yaml로 이름을 바꾸고, secret 값을 본인 것으로 채워넣으세요.
# (application-jwt.yaml은 .gitignore에 등록되어 있어 git에는 올라가지 않습니다.)
# secret은 팀 내부에서 별도로 전달받은 값을 쓰거나, 아래처럼 무작위 base64 문자열을 새로 생성해도 됩니다.
#   예: openssl rand -base64 64

jwt:
  secret: 여기에_JWT_시크릿_키를_붙여넣으세요
  access-token-validity-in-seconds: 1209600
  refresh-token-validity-in-seconds: 2592000
